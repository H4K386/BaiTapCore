@model _0306241284_NguyenKhanhHuy.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning bg-opacity-25 py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa danh mục
                    </h6>
                    <span class="text-muted small">ID: @Model?.Id</span>
                </div>

                <div class="card-body p-4">
                    <form asp-area="Admin" asp-controller="Category" asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Giữ lại Id để Controller biết cập nhật bản ghi nào -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Hiển thị tổng hợp lỗi nếu có -->
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Tên danh mục -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Tên danh mục <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Mô tả -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả tóm tắt..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Các nút thao tác -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning text-dark fw-semibold px-4">
                                <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
    }
}
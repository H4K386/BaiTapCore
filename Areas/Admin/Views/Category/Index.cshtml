@using System.Linq
@model IEnumerable<_0306241284_NguyenKhanhHuy.Models.Category>
    <div class="row g-4">
        <!-- Cột trái: Form thêm danh mục -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h2 class="mb-0 fw-bold">Thêm danh mục mới</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Đồ gia dụng" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mô tả</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Ghi chú ngắn gọn..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Thêm danh mục
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng danh sách danh mục -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">Danh sách danh mục</h6>
                    <span class="badge bg-secondary">Tổng cộng: @Model.Count() </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;">#</th>
                                    <th>Tên danh mục</th>
                                    <th>Mô tả</th>
                                    <th class="text-center" style="width: 140px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>                             
                                @if (Model != null && Model.Any())
                                {
                                    int index = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td class="fw-semibold">@item.Name</td>
                                            <td class="text-muted small">@item.Description</td>
                                            <td class="text-center">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Sửa</a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa danh mục này?')">Xóa</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
    @{

    }
}
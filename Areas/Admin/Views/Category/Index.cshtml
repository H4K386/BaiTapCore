@using System.Linq
@model IEnumerable<_0306241284_NguyenKhanhHuy.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<!-- TIÊU ĐỀ TRANG THEO PHONG CÁCH STARTMIN -->
<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Danh mục sản phẩm</h1>
    </div>
</div>

<div class="row">
    <!-- CỘT TRÁI: FORM THÊM MỚI (PANEL PRIMARY) -->
    <div class="col-md-4">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-plus-circle fa-fw"></i> Thêm danh mục mới
            </div>
            <div class="panel-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Đồ gia dụng" required />
                    </div>

                    <div class="form-group">
                        <label>Mô tả</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Ghi chú ngắn gọn..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fa fa-save"></i> Thêm danh mục
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: BẢNG DANH SÁCH (PANEL DEFAULT) -->
    <div class="col-md-8">
        <div class="panel panel-default">
            <div class="panel-heading clearfix">
                <span class="pull-left" style="line-height: 24px;">
                    <i class="fa fa-tags fa-fw"></i> Danh sách danh mục
                </span>
                <span class="label label-info pull-right" style="font-size: 13px;">
                    Tổng cộng: @(Model?.Count() ?? 0)
                </span>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th>Tên danh mục</th>
                                <th>Mô tả</th>
                                <th class="text-center" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int index = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@(index++)</td>
                                        <td><strong>@item.Name</strong></td>
                                        <td class="text-muted small">@item.Description</td>
                                        <td class="text-center">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-xs" title="Chỉnh sửa">
                                                <i class="fa fa-pencil"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-xs" onclick="return confirm('Xóa danh mục này?');" title="Xóa">
                                                <i class="fa fa-trash"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">Chưa có danh mục nào trong hệ thống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            alert('@Html.Raw(TempData["SuccessMessage"])');
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            alert('@Html.Raw(TempData["ErrorMessage"])');
        </script>
    }
}
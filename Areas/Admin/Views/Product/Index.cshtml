@model IEnumerable<_0306241284_NguyenKhanhHuy.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Sản phẩm</h1>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading clearfix">
                <span class="pull-left" style="line-height: 34px;"><i class="fa fa-cubes fa-fw"></i> Danh sách sản phẩm</span>
                <a asp-action="Create" class="btn btn-primary btn-sm pull-right">
                    <i class="fa fa-plus"></i> Thêm sản phẩm mới
                </a>
            </div>
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th style="width: 80px;" class="text-center">Hình ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th class="text-right">Giá</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int stt = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@(stt++)</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.Image))
                                            {
                                                <img src="~/images/products/@item.Image" alt="@item.Name" width="50" height="50" style="object-fit: cover; border-radius: 4px;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="fa fa-image fa-2x"></i></span>
                                            }
                                        </td>
                                        <td><strong>@item.Name</strong></td>
                                        <td><span class="label label-info">@(item.Category?.Name ?? "Không có")</span></td>
                                        <td class="text-right">@item.Price.ToString("N0") đ</td>
                                        <td class="text-center">
                                            @if (item.Status)
                                            {
                                                <span class="label label-success">Kinh doanh</span>
                                            }
                                            else
                                            {
                                                <span class="label label-default">Tạm ngừng</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-xs" title="Chỉnh sửa">
                                                <i class="fa fa-pencil"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-xs" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');" title="Xóa">
                                                <i class="fa fa-trash"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted">Chưa có sản phẩm nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            alert('@Html.Raw(TempData["SuccessMessage"])');
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            alert('@Html.Raw(TempData["ErrorMessage"])');
        </script>
    }
}